        <PostList posts={sortedPosts} />
    </SectionContainer>
    <SectionContainer class="tags--container">
        <div class="flex flex-row my-4 items-center text-secondary-600 dark:text-secondary-200">
            <h2
                class="font-medium text-h4 text-text dark:text-cream m-4 leading-8 tracking-tighter mb-0 font-body"
            >
                Top Tags
            </h2>

            <a href="/tags" class="font-medium flex no-underline ml-auto mr-4 px-4 py-1.5 rounded-full text-sm hover:bg-secondary-100 dark:hover:bg-secondary-800 hover:text-secondary-900 dark:hover:text-white transition-all duration-300 font-sans items-center">
                View all tags
                <Icon name="ph:arrow-right-light" class="w-5 h-5 ml-2" />
            </a>
        </div>

        <ul class="list-none flex flex-wrap gap-4 px-4">
            {
                tags.map((tag) => (
                    <li class={`inline-block`}>
                        <a
                            href={`/tags/${tag.toLowerCase()}`}
                            class={`text-lg text-secondary-600 dark:text-secondary-200 pr-2 flex flex-wrap items-center relative underline hover:text-secondary-900 dark:hover:text-white decoration-secondary-200
                            decoration-2 transition-all duration-300 hover:-translate-y-0.5 focus-visible:p-1`}
                        >
                            <Icon name="tabler:hash" class="w-5 h-5 text-mint-icon" />
                            &nbsp;<span>{tag.toLowerCase()}</span>
                        </a>
                    </li>
                ))
            }
        </ul>
    </SectionContainer>
      -->
</Layout>

<script>
    // Lazy-load the boids web component on the client so the home page
    // stays SSR-safe even though the component touches three.js / WebGL.
    if (typeof window !== "undefined") {
        import("jdls-boids-canvas").catch((err) => {
            console.warn("Failed to load boids webcomponent:", err);
        });
    }

    // "Now spinning" custom audio player. One [data-player] root per tile.
    // The Deezer API doesn't return CORS headers so the browser can't fetch
    // it directly — the playlist is fetched server-side at build time and
    // embedded in a <script type="application/json"> tag inside the tile.
    type DeezerTrack = {
        id: number;
        title: string;
        duration: number;
        preview: string;
        artist: { name: string } | string;
    };

    const escapeHtml = (s: string) =>
        s.replace(/[&<>"']/g, (c) =>
            ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c] as string)
        );

    document.querySelectorAll<HTMLElement>("[data-player]").forEach((player) => {
        const audio = player.querySelector<HTMLAudioElement>("[data-player-audio]")!;
        const toggle = player.querySelector<HTMLButtonElement>("[data-player-toggle]")!;
        const icon = player.querySelector<HTMLElement>("[data-player-icon]")!;
        const progress = player.querySelector<HTMLElement>("[data-player-progress]")!;
        const currentEl = player.querySelector<HTMLElement>("[data-player-current]")!;
        const durationEl = player.querySelector<HTMLElement>("[data-player-duration]")!;
        const titleEl = player.querySelector<HTMLElement>("[data-player-title]")!;
        const titleOverlay = player.querySelector<HTMLElement>("[data-player-title-overlay]")!;
        const coverEl = player.querySelector<HTMLImageElement>("[data-player-cover]")!;
        const dot = player.querySelector<HTMLElement>("[data-player-dot]")!;
        const orbits = player.querySelectorAll<HTMLElement>("[data-player-orbit]");
        const tracksList = player.querySelector<HTMLElement>("[data-player-tracks]")!;
        const payload = player.querySelector<HTMLScriptElement>("[data-player-playlist]");

        let tracks: DeezerTrack[] = [];
        let currentIndex = -1;
        let isPlaying = false;

        const fmt = (s: number) => {
            if (!isFinite(s) || s < 0) return "0:00";
            const m = Math.floor(s / 60);
            const sec = Math.floor(s % 60);
            return `${m}:${String(sec).padStart(2, "0")}`;
        };

        const setPlaying = (playing: boolean) => {
            isPlaying = playing;
            icon.textContent = playing ? "❚❚" : "▶";
            dot.classList.toggle("bg-mint-icon", playing);
            dot.classList.toggle("animate-pulse", playing);
            dot.classList.toggle("bg-secondary-300", !playing);
            dot.classList.toggle("dark:bg-white/40", !playing);

            // Speed the orbits up when audio plays; ease back when paused.
            orbits.forEach((orbit) => {
                const reverse = orbit.dataset.reverse === "true";
                orbit.style.animationDuration = playing
                    ? reverse
                        ? "6s"
                        : "4s"
                    : reverse
                      ? "40s"
                      : "18s";
            });

            // Active-track marker: replace the number with ▶ while playing.
            tracksList.querySelectorAll<HTMLElement>("[data-player-num]").forEach((num) => {
                const idx = Number(num.dataset.idx);
                if (idx === currentIndex) {
                    num.textContent = playing ? "▶" : String(idx + 1).padStart(2, "0");
                }
            });
        };

        const loadTrack = (index: number, autoplay: boolean) => {
            const track = tracks[index];
            if (!track || !track.preview) return;
            currentIndex = index;
            audio.src = track.preview;
            titleEl.textContent = track.title;
            progress.style.width = "0%";
            currentEl.textContent = "0:00";
            durationEl.textContent = "0:00";

            // Swap album art into the inner orbit circle. If the track has no
            // cover (rare), keep the title overlay visible.
            const cover = track.album?.cover_medium ?? track.album?.cover_big ?? "";
            if (cover) {
                coverEl.src = cover;
                coverEl.alt = track.album?.title ?? track.title;
                coverEl.classList.remove("opacity-0");
                coverEl.classList.add("opacity-100");
                titleOverlay.classList.remove("opacity-100");
                titleOverlay.classList.add("opacity-0");
            } else {
                coverEl.removeAttribute("src");
                coverEl.classList.remove("opacity-100");
                coverEl.classList.add("opacity-0");
                titleOverlay.classList.remove("opacity-0");
                titleOverlay.classList.add("opacity-100");
            }

            tracksList.querySelectorAll<HTMLElement>("[data-player-track]").forEach((b) => {
                b.classList.toggle(
                    "text-mint-icon",
                    Number(b.dataset.index) === index
                );
            });

            if (autoplay) {
                audio.play().catch((err) => console.warn("Playback failed:", err));
            }
        };

        toggle.addEventListener("click", () => {
            if (currentIndex === -1) {
                loadTrack(0, true);
            } else if (audio.paused) {
                audio.play().catch((err) => console.warn("Playback failed:", err));
            } else {
                audio.pause();
            }
        });

        tracksList.addEventListener("click", (event) => {
            const target = event.target as HTMLElement;
            const btn = target.closest<HTMLElement>("[data-player-track]");
            if (!btn) return;
            const idx = Number(btn.dataset.index);
            if (currentIndex === idx && !audio.paused) {
                audio.pause();
            } else {
                loadTrack(idx, true);
            }
        });

        audio.addEventListener("play", () => setPlaying(true));
        audio.addEventListener("pause", () => setPlaying(false));
        audio.addEventListener("ended", () => {
            // Advance to the next track that has a preview.
            for (let i = currentIndex + 1; i < tracks.length; i++) {
                if (tracks[i].preview) {
                    loadTrack(i, true);
                    return;
                }
            }
            setPlaying(false);
        });
        audio.addEventListener("timeupdate", () => {
            if (!isFinite(audio.duration) || audio.duration === 0) return;
            progress.style.width = `${(audio.currentTime / audio.duration) * 100}%`;
            currentEl.textContent = fmt(audio.currentTime);
        });
        audio.addEventListener("loadedmetadata", () => {
            durationEl.textContent = fmt(audio.duration);
        });
        audio.addEventListener("error", () => {
            titleEl.textContent = "— couldn't load track —";
            setPlaying(false);
        });

        // Read the build-time playlist payload and render rows. Tracks with
        // an empty `preview` are shown but disabled (greyed out).
        const renderError = (message: string) => {
            tracksList.innerHTML = `<li class="px-1 py-2 font-mono text-[0.65rem] uppercase tracking-[0.18em] text-secondary-400 dark:text-white/40">${escapeHtml(message)}</li>`;
        };

        try {
            tracks = payload?.textContent ? JSON.parse(payload.textContent) : [];
        } catch (err) {
            console.warn("Failed to parse embedded playlist payload:", err);
            tracks = [];
        }

        if (tracks.length === 0) {
            renderError("Playlist unavailable — rebuild to fetch fresh data");
        } else {
            tracksList.innerHTML = tracks
                .map((t, i) => {
                    const num = String(i + 1).padStart(2, "0");
                    const title = escapeHtml(t.title);
                    const artist =
                        typeof t.artist === "string"
                            ? t.artist
                            : t.artist?.name ?? "";
                    if (t.preview) {
                        return `
                            <li>
                                <button
                                    type="button"
                                    data-player-track
                                    data-index="${i}"
                                    class="group flex w-full items-center gap-3 px-1 py-1.5 text-left transition-colors"
                                >
                                    <span
                                        data-player-num
                                        data-idx="${i}"
                                        class="w-5 shrink-0 font-mono text-[0.6rem] uppercase tracking-[0.18em] text-secondary-400 dark:text-white/40 transition-colors group-hover:text-mint-icon"
                                    >${num}</span>
                                    <span class="flex-1 min-w-0 overflow-hidden">
                                        <span
                                            data-player-track-title
                                            data-marquee
                                            class="inline-block whitespace-nowrap font-title text-sm text-text dark:text-white transition-colors group-hover:text-mint-icon"
                                        >${title} <span class="font-mono text-[0.6rem] uppercase tracking-[0.15em] text-secondary-400 dark:text-white/40">&nbsp; ${escapeHtml(artist)}</span></span>
                                    </span>
                                </button>
                            </li>`;
                    }
                    return `
                        <li>
                            <div
                                class="flex items-center gap-3 px-1 py-1.5 opacity-40 cursor-not-allowed"
                                title="Preview not available on Deezer"
                            >
                                <span class="w-5 shrink-0 font-mono text-[0.6rem] uppercase tracking-[0.18em] text-secondary-400 dark:text-white/40">${num}</span>
                                <span class="flex-1 min-w-0 overflow-hidden">
                                    <span class="inline-block whitespace-nowrap font-title text-sm text-secondary-500 dark:text-white/50">${title} <span class="font-mono text-[0.6rem] uppercase tracking-[0.15em] text-secondary-400 dark:text-white/40">— ${escapeHtml(artist)}</span></span>
                                </span>
                            </div>
                        </li>`;
                })
                .join("");

            // Wire up hover-scrolling marquees on title and artist. The
            // inner span (data-marquee) is wider than its overflow-hidden
            // parent when the text doesn't fit; on hover we translate it by
            // the overflow distance so the rest becomes visible. On leave
            // we snap back.
            const startMarquee = (el: HTMLElement) => {
                const parent = el.parentElement;
                if (!parent) return;
                const distance = el.scrollWidth - parent.clientWidth;
                if (distance <= 0) return;
                el.style.transition = `transform ${Math.max(0.6, distance / 30)}s linear`;
                el.style.transform = `translateX(-${distance}px)`;
            };
            const stopMarquee = (el: HTMLElement) => {
                el.style.transition = "transform 0.25s ease";
                el.style.transform = "translateX(0)";
            };

            tracksList
                .querySelectorAll<HTMLButtonElement>("[data-player-track]")
                .forEach((btn) => {
                    const marquees = btn.querySelectorAll<HTMLElement>("[data-marquee]");
                    btn.addEventListener("mouseenter", () =>
                        marquees.forEach(startMarquee)
                    );
                    btn.addEventListener("mouseleave", () =>
                        marquees.forEach(stopMarquee)
                    );
                });
        }
    });
</script>
