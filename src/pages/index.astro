---
import Layout from "@/layouts/Layout.astro";
import projectData from "@/data/projectData.json";
import CanvasIk from "@/components/flower/canvas-ik.astro";
import CardStack from "@/components/card-stack/CardStack.astro";
import Card from "@/components/card-stack/Card.astro";
import Scene from "@/components/react/scene";

const projects = projectData;
---

<Layout title="jdlennoxs" description="">
    <div class="mx-auto max-w-6xl px-6 py-10 md:px-10 md:py-14">
        <div class="h-[5vh]"></div>
        <Scene client:load />
        <section class="relative col-span-12 md:col-span-10 row-span-3 overflow-hidden">
            <div class="relative z-10 flex h-full flex-col justify-end gap-4">
                <h1 class="font-title text-5xl leading-[1.05] tracking-tight text-badge-text md:text-7xl">
                    <span class="italic font-normal text-mint-icon underline">Jack</span> builds <span class="italic font-normal text-accent-500">random</span> things on the{" "}web because he wants to<span class="font-normal text-bubblegum">.</span>
                </h1>
                <span class="text-xs uppercase tracking-[0.2em] text-secondary-400 dark:text-white/40">
                    Based in Bristol · available for projects | talks | ideas
                </span>
            </div>
        </section>
    </div>

    <CardStack>
        {projects.map((project, index) => (
            <Card
                index={index}
                topic={project.topic}
                title={project.title}
                sub={project.sub}
                body={project.body}
                link={project.link || project.post}
                linkLabel={project.linkLabel ?? (project.post ? "Read more" : "Visit")}
            >
                {project.component === "boids" && (
                    <div slot="media" class="relative h-120 md:h-170 w-full">
                        <boids-canvas
                            class="w-full overflow-hidden rounded-3xl"
                            background-color="#5162FF"
                            light-color="#FFFCEC"
                            fog-color="#9DA7FF"
                            boid-color="#40e0d0"
                            highlight="#ffc0cb"
                            count="80"
                            use-orbit-controls="false"
                            duration="30"
                            forces='{"separation": 0.9, "cohesion": 0.85, "alignment": 0.2, "goal": 0.3}'
                            orientation-slerp="0.2"
                        />
                        {project.badgeContent && (
                            <span class="pointer-events-none absolute right-5 top-4 inline-flex h-7 px-2 items-center justify-center rounded-full border border-white/40 font-mono text-[0.65rem] uppercase tracking-[0.18em] text-white/70">
                                {project.badgeContent}
                            </span>
                        )}
                    </div>
                )}
                {project.component === "IkCanvas" && (
                    <div slot="media" class="h-120 md:h-170 bg-[#ede6d8]">
                        <CanvasIk />
                    </div>
                )}
                {!project.component && project.image && (
                    <img
                        slot="media"
                        src={project.image}
                        alt=""
                        class="h-full w-full object-cover"
                    />
                )}
            </Card>
        ))}
    </CardStack>
</Layout>

<script>
    // Lazy-load the boids web component on the client so the home page
    // stays SSR-safe even though the component touches three.js / WebGL.
    if (typeof window !== "undefined") {
        import("jdls-boids-canvas").catch((err) => {
            console.warn("Failed to load boids webcomponent:", err);
        });
    }
</script>
