---
import Layout from "@/layouts/Layout.astro";
import SectionContainer from "@/components/SectionContainer.astro";
import projectData from "@/data/projectData.json";
import { getCollection } from "astro:content";
import { Icon } from "astro-icon/components";
import getSortedTags from "@/utils/getSortedTags";
import { SITE } from "@config";
import ProjectCardGroup from "@/components/projects/ProjectCardGroup.astro";
import PostList from "@/components/posts/PostList.astro";
import HeroBento from "@/components/hero/HeroBento.astro";
import CanvasIk from "@/components/flower/canvas-ik.astro";
import CardStack from "@/components/card-stack/CardStack.astro";
import Card from "@/components/card-stack/Card.astro";
import Scene from "@/components/react/scene";


const posts = await getCollection("post");

const tags = getSortedTags(posts).slice(0, 6);
const sortedPosts = posts
    .filter((post) => post.data.featured == true && !post.data.project)
    .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
    .slice(0, SITE.postPerPage);

// Recent transmissions uses the freshest non-project posts (not just featured),
// so the bento tile stays populated even when few posts are flagged featured.
const recentPosts = posts
    .filter((post) => !post.data.project && !post.data.draft)
    .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
    .slice(0, 4);

// Short "MON DD" labels matching the mono-label styling on the post list.
// UTC components keep server and client renders stable.
const MONTHS = ["JAN", "FEB", "MAR", "APR", "MAY", "JUN", "JUL", "AUG", "SEP", "OCT", "NOV", "DEC"];
const formatDate = (d: Date) =>
    `${MONTHS[d.getUTCMonth()]} ${String(d.getUTCDate()).padStart(2, "0")}`;

const projects = projectData;

// Playlist for the "Now spinning" tile is fetched server-side at build
// time. The Deezer API doesn't return CORS headers so the browser can't
// call it directly; we have to proxy at build time. Trade-off: preview
// URLs are signed and expire within ~24h, so the audio will stop working
// until the site is rebuilt. (To get truly fresh URLs on every visit,
// add @astrojs/vercel + output:'hybrid' and run this fetch in an API route.)
const DEEZER_PLAYLIST_ID = "15520933601";
const DEEZER_PLAYLIST_URL = "https://link.deezer.com/s/33OfjUeUhKe38TFUQyqqW"
const DEEZER_TRACK_LIMIT = 10;

type DeezerTrack = {
    id: number;
    title: string;
    duration: number;
    preview: string;
    time_add?: number;
    artist: { name: string } | string;
    album?: {
        id: number;
        title: string;
        cover_medium?: string;
        cover_big?: string;
    };
};

let playlistData: DeezerTrack[] = [];
try {
    // `order=date_desc` asks Deezer to return most-recently-added tracks first.
    // The trailing client-side sort is a fallback in case the API ignores it.
    const res = await fetch(
        `https://api.deezer.com/playlist/${DEEZER_PLAYLIST_ID}?order=date_desc`
    );
    if (res.ok) {
        const data = await res.json();
        playlistData = (data.tracks?.data ?? [])
            .slice(0, DEEZER_TRACK_LIMIT)
            .sort((a, b) => (b.time_add ?? 0) - (a.time_add ?? 0));
    } else {
        console.warn(`Deezer playlist fetch returned HTTP ${res.status}`);
    }
} catch (err) {
    console.warn("Deezer playlist fetch failed at build time:", err);
}
