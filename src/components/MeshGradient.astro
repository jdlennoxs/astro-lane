---
// ponytail: small-radius mesh gradient on theme bg, dark-aware via CSS vars
---

<div
  class="absolute inset-0 h-[800px] pointer-events-none z-[-1] bg-background overflow-hidden"
  aria-hidden="true"
>
  <div class="absolute inset-0 mesh-layer"></div>
</div>

<style>
  .mesh-layer {
    /* Light-mode defaults — soft versions of the palette */
    --g1: color-mix(in srgb, var(--color-primary-500) 28%, transparent);
    --g2: color-mix(in srgb, var(--color-primary-500) 20%, transparent);
    --g3: color-mix(in srgb, var(--bubblegum) 23%, transparent);
    --g4: color-mix(in srgb, var(--bubblegum) 18%, transparent);
    --g5: color-mix(in srgb, var(--aqua) 21%, transparent);
    --g6: color-mix(in srgb, var(--aqua) 17%, transparent);

    background:
      radial-gradient(ellipse 35% 30% at 72% 35%, var(--g1), transparent),
      radial-gradient(ellipse 25% 20% at 55% 55%, var(--g2), transparent),
      radial-gradient(ellipse 30% 25% at 85% 50%, var(--g3), transparent),
      radial-gradient(ellipse 20% 18% at 78% 70%, var(--g4), transparent),
      radial-gradient(ellipse 26% 28% at 65% 25%, var(--g5), transparent),
      radial-gradient(ellipse 22% 20% at 90% 60%, var(--g6), transparent);
  }

  :global(:root.dark) .mesh-layer {
    --g1: color-mix(in srgb, var(--color-primary-500) 25%, transparent);
    --g2: color-mix(in srgb, var(--color-primary-500) 14%, transparent);
    --g3: color-mix(in srgb, var(--bubblegum) 18%, transparent);
    --g4: color-mix(in srgb, var(--bubblegum) 10%, transparent);
    --g5: color-mix(in srgb, var(--aqua) 16%, transparent);
    --g6: color-mix(in srgb, var(--aqua) 9%, transparent);
  }
</style>