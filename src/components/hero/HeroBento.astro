---
import SaturnMark from "@/components/hero/SaturnMark.astro";

export interface Props {
    tags: string[];
}

const { tags } = Astro.props;
---

<div class="mx-auto max-w-6xl px-6 py-10 md:px-10 md:py-14">
    <div class="grid grid-cols-12 auto-rows-[7.5rem] gap-4 md:gap-5">
        {/* Intro / Hero tile */}
        <section class="relative col-span-12 row-span-4 overflow-hidden rounded-3xl border border-white/5 bg-[#0a0a0c] p-8 md:col-span-8 md:p-10">
            <SaturnMark class="pointer-events-none absolute -right-24 -top-24 h-[28rem] w-[28rem] text-mint-icon opacity-90 [animation:spin_60s_linear_infinite]" />
            <div class="absolute inset-0 bg-gradient-to-tr from-[#0a0a0c] via-[#0a0a0c]/70 to-transparent"></div>
            <div class="relative z-10 flex h-full flex-col justify-between gap-10">
                <span class="text-xs uppercase tracking-[0.2em] text-[#ff7fa5] font-mono">jdlennoxs · v.3 orbital</span>
                <h1 class="font-title text-4xl leading-[1.05] tracking-tight text-white md:text-6xl">
                    Crafting{" "}
                    <span class="italic font-normal text-mint-icon">digital orbits</span>{" "}
                    at the intersection of design and code.
                </h1>
                <div class="flex flex-wrap items-center gap-4">
                    <a
                        href="/about"
                        class="group inline-flex items-center gap-3 rounded-full border border-primary-500/70 bg-primary-500/10 px-5 py-2 text-sm text-white transition-colors hover:bg-primary-500"
                    >
                        About me
                        <span aria-hidden class="transition-transform group-hover:translate-x-0.5">→</span>
                    </a>
                    <span class="text-xs uppercase tracking-[0.2em] text-white/40">
                        London · available for projects
                    </span>
                </div>
            </div>
        </section>

        {/* Tags tile (top-right) */}
        <section class="relative col-span-12 row-span-2 overflow-hidden rounded-3xl bg-mint-icon p-6 text-[#27272a] md:col-span-4">
            <div class="flex items-center justify-between">
                <span class="font-mono text-[0.65rem] uppercase tracking-[0.18em]">Top Tags</span>
                <span class="h-2 w-2 animate-pulse rounded-full bg-[#27272a]/70"></span>
            </div>
            <ul class="mt-4 flex flex-wrap gap-2">
                {tags.map((tag) => (
                    <li>
                        <a
                            href={`/tags/${tag.toLowerCase()}`}
                            class="inline-flex items-center gap-1 rounded-full bg-[#27272a]/10 px-3 py-1 text-xs font-semibold text-[#27272a] transition-colors hover:bg-[#27272a] hover:text-white"
                        >
                            <span>#</span>{tag.toLowerCase()}
                        </a>
                    </li>
                ))}
            </ul>
        </section>

        {/* Status / interactive tile */}
        <a
            href="/projects"
            class="group relative col-span-6 row-span-2 overflow-hidden rounded-3xl border border-white/5 bg-[#0a0a0c] p-6 md:col-span-4"
        >
            <div class="absolute inset-0 flex items-center justify-center opacity-80">
                <div class="relative h-28 w-28 rounded-full border border-white/15 [animation:spin_18s_linear_infinite]">
                    <span class="absolute -top-1.5 left-1/2 h-3 w-3 -translate-x-1/2 rounded-full bg-[#ff7fa5] shadow-[0_0_18px_#ff7fa5]"></span>
                </div>
                <div class="absolute h-44 w-44 rounded-full border border-dashed border-white/10 [animation:spin_40s_linear_infinite_reverse]"></div>
            </div>
            <div class="relative z-10 flex h-full flex-col justify-between">
                <span class="text-xs uppercase tracking-[0.2em] text-mint-icon font-mono">Now orbiting</span>
                <span class="font-title text-xl italic text-white">
                    Boids &amp; flocking toys
                </span>
            </div>
        </a>

        {/* Featured project tile */}
        <a
            href="/projects"
            class="group relative col-span-6 row-span-2 overflow-hidden rounded-3xl bg-primary-500 p-6 text-white md:col-span-4"
        >
            <div class="absolute -bottom-16 -right-10 h-56 w-56 rounded-full border border-white/20"></div>
            <div class="absolute -bottom-20 -right-14 h-64 w-64 rounded-full border border-white/10"></div>
            <span class="absolute right-5 top-4 font-title text-3xl italic text-white/40">
                01
            </span>
            <div class="relative z-10 flex h-full flex-col justify-end">
                <span class="font-mono text-[0.65rem] uppercase tracking-[0.18em] text-white/70">Featured project</span>
                <h3 class="mt-1 font-title text-2xl tracking-tight">Re:Tuned</h3>
                <p class="text-sm text-white/80">
                    A daily ritual for re-discovering music.
                </p>
            </div>
        </a>
    </div>
</div>