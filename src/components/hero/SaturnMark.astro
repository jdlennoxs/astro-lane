---
// Decorative planet glyph used as a background flourish. Renders inline so it
// inherits `currentColor` from the parent text-* class. Caller controls
// sizing/positioning via the `class` prop. Pass `tilt` (degrees) to rotate
// the glyph; the rotation is composed onto whatever transform the caller's
// utility classes apply via the inline `style` attribute.
export interface Props {
    class?: string;
    tilt?: number;
}

const { class: className, tilt = 0 } = Astro.props;
const styleAttr = tilt ? `transform: rotate(${tilt}deg);` : undefined;
