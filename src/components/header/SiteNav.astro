---
import ThemeToggle from "@/components/header/ThemeToggle.astro";
import { Icon } from "astro-icon/components";
import planet from "./thick.svg?raw";

const items = [
    { href: "/projects", label: "Projects" },
    { href: "/posts", label: "Signals" },
    { href: "/about", label: "Info" },
] as const;

const pathname = Astro.url.pathname.replace(/\/$/, "") || "/";

const isActive = (href: string) => {
    const normalized = href.replace(/\/$/, "") || "/";
    if (normalized === "/") return pathname === "/";
    return pathname === normalized || pathname.startsWith(`${normalized}/`);
};

// Strip the SVG's hardcoded width/height so Tailwind's h-5 w-5 sizing applies.
const planetIcon = planet.replace(/<svg([^>]*)>/, (_match, attrs) =>
    `<svg${attrs.replace(/\s*width="[^"]*"/, "").replace(/\s*height="[^"]*"/, "")} width="100%" height="100%" aria-hidden="true">`
);
---
 <!-- class="sticky top-0 z-40 border-b border-secondary-200/70 dark:border-white/10 bg-background/70 dark:bg-[var(--paper)]/80 backdrop-blur-md supports-[backdrop-filter]:bg-background/70 shadow-sm transition-colors duration-300" -->
<header
    id="site-nav"
    class="top-0"
>

    <div class="mx-auto flex h-14 max-w-6xl items-center justify-between px-6 md:px-10">
        {/* Wordmark — planet glyph tilted by default, straightens on hover */}
        <a
            href="/"
            aria-label="Home"
            class="group flex items-center gap-2 text-xl leading-none tracking-tight text-text dark:text-white font-title"
        >
            <span class="h-6 w-6 inline-flex transition-transform duration-300 ease-out group-hover:rotate-12 text-primary-500">
                <Fragment set:html={planetIcon} />
            </span>
            <span>jdlennoxs</span>
        </a>

        {/* Desktop nav */}
        <nav class="hidden md:flex items-center gap-1 text-sm font-sans" aria-label="Main">
            {
                items.map((item) => {
                    const active = isActive(item.href);
                    const base =
                        "relative rounded-full px-3 py-1.5 transition-colors duration-200";
                    const state = active
                        ? "text-text dark:text-white bg-neutral-100 dark:bg-white/5 ring-1 ring-neutral-200 dark:ring-white/10"
                        : "text-secondary-500 dark:text-white/55 hover:text-text dark:hover:text-white";
                    return (
                        <a
                            href={item.href}
                            aria-current={active ? "page" : undefined}
                            class:list={[base, state]}
                        >
                            {item.label}
                        </a>
                    );
                })
            }
           
            <ThemeToggle />
        </nav>

        {/* Mobile toggle */}
        <button
            type="button"
            class="md:hidden inline-flex h-10 w-10 items-center justify-center rounded-lg text-secondary-600 dark:text-secondary-200 hover:bg-secondary-100 dark:hover:bg-secondary-800 transition-colors"
            aria-label="Toggle navigation"
            aria-expanded="false"
            aria-controls="site-nav-drawer"
            data-site-nav-toggle
        >
            <Icon name="tabler:menu-2" class="h-5 w-5" />
        </button>
    </div>

    {/* Mobile drawer */}
    <div
        id="site-nav-drawer"
        class="md:hidden overflow-hidden max-h-0 transition-[max-height] duration-300 ease-out border-t border-transparent"
        data-site-nav-drawer
    >
        <nav
            class="flex flex-col gap-1 px-6 py-3 text-sm font-sans"
            aria-label="Mobile"
        >
            {
                items.map((item) => {
                    const active = isActive(item.href);
                    const base = "rounded-full px-3 py-2 transition-colors duration-200";
                    const state = active
                        ? "text-text dark:text-white bg-secondary-100 dark:bg-white/5 ring-1 ring-secondary-200 dark:ring-white/10"
                        : "text-secondary-600 dark:text-white/55 hover:text-text dark:hover:text-white";
                    return (
                        <a
                            href={item.href}
                            aria-current={active ? "page" : undefined}
                            class:list={[base, state]}
                        >
                            {item.label}
                        </a>
                    );
                })
            }
            <div class="pt-2">
                <ThemeToggle />
            </div>
        </nav>
    </div>
</header>

<script>
    const toggle = document.querySelector<HTMLButtonElement>("[data-site-nav-toggle]");
    const drawer = document.querySelector<HTMLDivElement>("[data-site-nav-drawer]");

    if (toggle && drawer) {
        const setOpen = (open: boolean) => {
            drawer.style.maxHeight = open ? `${drawer.scrollHeight}px` : "0px";
            drawer.classList.toggle("border-secondary-200/70", open);
            drawer.classList.toggle("dark:border-white/5", open);
            drawer.classList.toggle("border-transparent", !open);
            toggle.setAttribute("aria-expanded", String(open));
            const icon = toggle.querySelector("[data-icon]") as HTMLElement | null;
            toggle.innerHTML = open
                ? '<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18M6 6l12 12"/></svg>'
                : '<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 6h16M4 12h16M4 18h16"/></svg>';
            icon; // referenced for clarity, value intentionally unused
        };

        toggle.addEventListener("click", () => {
            const isOpen = toggle.getAttribute("aria-expanded") === "true";
            setOpen(!isOpen);
        });
    }
</script>