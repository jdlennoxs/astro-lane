---
// Import the global.css file here so that it is included on
// all pages through the use of the <SEO /> component.
import "../styles/tailwind.css";
import "../themes/base.css";
import "../styles/core/_misc.css";
import "../styles/core/_general.css";
import "../styles/core/_typography.css";
import "../styles/core/_utilities.css";
import SEO from "@/components/seo/SEO.astro";
import SiteNav from "@/components/header/SiteNav.astro";
import Analytics from '@vercel/analytics/astro';
import MeshGradient from "@/components/MeshGradient.astro";

interface Props {
    class?: string;
    title: string;
    description?: string;
    keywords?: string;
    url?: string;
    image?: string;
    children?: any;
}

const currentYear = new Date().getFullYear();

const {
    class: className,
    title,
    description,
    keywords,
    url,
    image
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
    <head>
        <SEO
            title={title}
            description={description}
            keywords={keywords}
            url={url}
            image={image}
        />
        <link href="/prism-night-owl-light.css" rel="stylesheet" />
        <script>
            // Initialize theme
            const theme = localStorage.getItem('theme') || (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
            document.documentElement.classList.add(theme);
        </script>
    </head>
    <body class="bg-background text-text transition-colors duration-300">
        <SiteNav />
        <!-- <MeshGradient /> -->
            <div
              class="fixed inset-0 pointer-events-none z-[-1] overflow-hidden"
              aria-hidden="true"
            >
              <div
                class="absolute -top-[300%] -left-[150%] h-[600%] w-[600%] opacity-14"
                style="background-image: url('data:image/svg+xml;base64,'); background-size: 500px; background-repeat: repeat;"
              ></div>
            </div>
        <main class="max-w-7xl mx-auto px-6 md:px-10 mt-8 md:mt-12">
            <slot />
            <footer class="mt-24 pt-8 pb-8 border-t border-secondary-200 dark:border-secondary-800">
                <div class="text-secondary-500 dark:text-secondary-400 text-sm text-right font-sans">
                    © {currentYear} jdlennoxs
                </div>
            </footer>
        </main>
        <Analytics />
    </body>
</html>
