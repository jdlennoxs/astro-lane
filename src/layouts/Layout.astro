---
// One style import. Order is declared in global.css so the cascade does not
// depend on the order of imports here.
import "../styles/global.css";
import SEO from "@/components/seo/SEO.astro";
import SiteNav from "@/components/header/SiteNav.astro";
import Analytics from '@vercel/analytics/astro';
import MeshGradient from "@/components/MeshGradient.astro";
import FooterContent from "@/components/footer/FooterContent.astro";
import Card from "@/components/card-stack/Card.astro";

interface Props {
    class?: string;
    title: string;
    description?: string;
    keywords?: string;
    url?: string;
    image?: string;
    children?: any;
}

const {
    class: className,
    title,
    description,
    keywords,
    url,
    image
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
    <head>
        <SEO
            title={title}
            description={description}
            keywords={keywords}
            url={url}
            image={image}
        />
        <script>
            // Initialize theme
            const theme = localStorage.getItem('theme') || (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
            document.documentElement.classList.add(theme);
        </script>
    </head>
    <body class="relative bg-background text-text transition-colors duration-300">
        {/* Dark hero band — full-bleed and scrolls away with the page.
            Must be a direct child of <body>: inside <main> it would be clamped
            to max-w-7xl and inset by the px-* padding. Absolute (not fixed) so
            it scrolls off; -z-10 puts it behind the nav and content.
            Fades to the page bg quickly (ramp finishes at 60% of 45vh). */}
        <div
            aria-hidden="true"
            class="pointer-events-none absolute inset-x-0 top-0 -z-10 h-[75vh] bg-gradient-to-b dark:from-primary-900 from-primary-200 from-50% to-background to-95%"
        />
            <div
              class="fixed inset-0 pointer-events-none z-[-1] overflow-hidden"
              aria-hidden="true"
            >
              <div
                class="absolute -top-[300%] -left-[150%] h-[600%] w-[600%] opacity-20"
                style="background-image: url('data:image/svg+xml;base64,'); background-size: 500px; background-repeat: repeat;"
              ></div>
            </div>
            <SiteNav />
            
        <main class="max-w-7xl mx-auto mt-8 md:mt-12 pb-20">
            <slot />
        </main>
        {/* Footer styled as the last card, sitting at the bottom of the page.
            The max-w-7xl + px wrapper mirrors <main> so its edges line up with
            the stacked cards on wide viewports, where <main> stops growing. */}
        <div class="max-w-7xl mx-auto px-4 md:px-6 lg:px-10">
            <Card footer index={0} topic="Elsewhere">
                <FooterContent />
            </Card>
        </div>
        <Analytics />
    </body>
</html>
